# scripts tracked at all (usually you DO want them in git):
# migrations/

# ── Uploads / user content ──────────────────────────────
app/static/uploads/
app/static/videos/
security_cache/

# ── Logs ─────────────────────────────────────────────────
*.log
logs/

# ── Editors / OS junk ────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ── Termux / local dev artifacts ────────────────────────
*.pyc
.cache/

# ── Distribution / packaging ─────────────────────────────
build/
dist/
*.egg-info/

config.py
