# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Virtual environments ────────────────────────────────
venv/
env/
.venv/
ENV/

# ── Environment / secrets ───────────────────────────────
.env
.flaskenv
*.pem
*.key

# ── Flask / instance ────────────────────────────────────
instance/
.webassets-cache

# ── Databases ────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
test.db

# ── Migrations (keep the folder, ignore generated cache) ─
