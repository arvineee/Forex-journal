# Copy to .env and set real values. Never commit .env.
# Generate a fresh key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_SECRET
ENV=production
DEBUG=false
COOKIE_SECURE=true
REMEMBER_COOKIE_DAYS=30
ENABLE_AI_SCHEDULER=false

# The app auto-detects the previous SQLite database path when it exists.
# Set SQLALCHEMY_DATABASE_URI explicitly only after confirming your intended database.
# SQLALCHEMY_DATABASE_URI=sqlite:////absolute/path/to/forex_journal.db

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
